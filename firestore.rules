// firestore.rules — À copier dans Firebase Console → Firestore → Règles

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Photos : lecture publique, écriture admin uniquement
    match /photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Disponibilités : lecture publique, écriture admin uniquement
    match /availability/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Réservations : lecture/écriture publique (les clientes créent des RDV)
    // Mais modification/suppression admin uniquement
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
